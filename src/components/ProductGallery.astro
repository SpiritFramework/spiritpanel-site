---
const shots = [
  {
    id: "dashboard",
    label: "Dashboard",
    title: "Client dashboard",
    description: "Servers at a glance — status, resources, and quick open.",
    src: "/gallery/dashboard.png",
    alt: "Spirit Panel client dashboard showing servers and status",
  },
  {
    id: "console",
    label: "Console",
    title: "Game server console",
    description: "Live output, power controls, and resource meters on the server.",
    src: "/gallery/console.png",
    alt: "Spirit Panel game server console with live log output",
  },
  {
    id: "files",
    label: "Files",
    title: "File manager",
    description: "Browse, edit, and manage files on the server from the browser.",
    src: "/gallery/files.png",
    alt: "Spirit Panel file manager for a game server",
  },
  {
    id: "admin",
    label: "Admin",
    title: "Admin home",
    description: "Fleet overview — nodes, servers, and the controls that run the panel.",
    src: "/gallery/admin.png",
    alt: "Spirit Panel admin home with fleet overview",
  },
];
---

<section
  class="section-rise relative overflow-hidden border-t border-line bg-[#090c12]"
  aria-label="Product gallery"
  data-gallery
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_0%,rgba(34,211,238,0.12),transparent_58%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(148,163,184,0.045)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.045)_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_20%,black,transparent_75%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-5 py-16 lg:py-24">
    <div class="max-w-2xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan">Product gallery</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-5xl">
        The panel in use.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        Four screens from a live install — dashboard, console, files, and admin.
      </p>
    </div>

    <div class="mt-10 flex gap-1 overflow-x-auto pb-1 lg:hidden [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <div
        class="flex min-w-full gap-1 rounded-2xl border border-white/10 bg-[#07090e]/80 p-1"
        role="tablist"
        aria-label="Gallery views"
        data-gallery-tabs-mobile
      >
        {
          shots.map((shot, index) => (
            <button
              type="button"
              role="tab"
              id={`gallery-tab-m-${shot.id}`}
              class="min-w-0 flex-1 rounded-xl px-3 py-2.5 text-center text-sm text-muted transition-colors hover:text-ink aria-[selected=true]:bg-white/[0.08] aria-[selected=true]:text-ink aria-[selected=true]:shadow-[inset_0_0_0_1px_rgba(34,211,238,0.35)]"
              data-gallery-tab
              data-gallery-id={shot.id}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`gallery-panel-${shot.id}`}
              tabindex={index === 0 ? 0 : -1}
            >
              {shot.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-8 grid gap-6 lg:mt-12 lg:grid-cols-[15.5rem_minmax(0,1fr)] lg:gap-8">
      <div
        class="hidden lg:flex lg:flex-col lg:gap-1"
        role="tablist"
        aria-label="Gallery views"
        data-gallery-tabs-desktop
      >
        {
          shots.map((shot, index) => (
            <button
              type="button"
              role="tab"
              id={`gallery-tab-${shot.id}`}
              class="rounded-2xl border border-transparent px-4 py-3.5 text-left transition-colors hover:border-white/10 hover:bg-white/[0.03] aria-[selected=true]:border-cyan/25 aria-[selected=true]:bg-[linear-gradient(135deg,rgba(34,211,238,0.1),rgba(99,102,241,0.08))] [&[aria-selected=true]_.gallery-num]:text-cyan [&[aria-selected=true]_.gallery-label]:text-ink [&[aria-selected=true]_.gallery-sub]:text-muted"
              data-gallery-tab
              data-gallery-id={shot.id}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`gallery-panel-${shot.id}`}
              tabindex={index === 0 ? 0 : -1}
            >
              <span class="flex items-baseline justify-between gap-3">
                <span class="gallery-num font-display text-[11px] tabular-nums text-faint">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="gallery-label font-display text-sm font-semibold tracking-tight text-muted">
                  {shot.label}
                </span>
              </span>
              <span class="gallery-sub mt-1.5 block text-sm leading-snug text-faint">
                {shot.title}
              </span>
            </button>
          ))
        }
      </div>

      <div class="relative min-w-0">
        <div
          class="pointer-events-none absolute -inset-x-6 -inset-y-8 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(34,211,238,0.16),transparent_62%)]"
          aria-hidden="true"
        >
        </div>
        <div class="rounded-[18px] bg-[linear-gradient(160deg,rgba(255,255,255,0.28),rgba(34,211,238,0.4)_12%,rgba(99,102,241,0.22)_38%,rgba(255,255,255,0.06)_70%)] p-px shadow-[0_40px_100px_-40px_rgba(34,211,238,0.55)]">
          <div class="overflow-hidden rounded-[17px] bg-[#07090e]">
            <div class="flex items-center gap-3 border-b border-white/10 bg-[#0c1018] px-4 py-3">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
                <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
                <span class="size-2.5 rounded-full bg-[#28c840]"></span>
              </div>
              <div class="min-w-0 flex-1 truncate rounded-full border border-white/10 bg-[#07090e] px-3 py-1 font-mono text-[11px] text-faint">
                panel.your-domain · <span data-gallery-url>dashboard</span>
              </div>
              <p class="hidden font-mono text-[11px] tabular-nums text-faint sm:block" data-gallery-count>
                01 / 04
              </p>
            </div>

            <div class="relative">
              {
                shots.map((shot, index) => (
                  <figure
                    class:list={["gallery-panel m-0", index === 0 ? "gallery-in block" : "hidden"]}
                    id={`gallery-panel-${shot.id}`}
                    role="tabpanel"
                    aria-label={shot.title}
                    data-gallery-panel
                    data-gallery-id={shot.id}
                    hidden={index !== 0}
                  >
                    <div class="relative aspect-video bg-[#0c1018]">
                      <img
                        src={shot.src}
                        alt={shot.alt}
                        width="1920"
                        height="1080"
                        loading={index === 0 ? "eager" : "lazy"}
                        decoding="async"
                        class="absolute inset-0 size-full object-cover object-top"
                        data-gallery-image
                      />
                      <div
                        class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-[radial-gradient(ellipse_at_center,rgba(34,211,238,0.08),transparent_62%)] px-6 text-center"
                        data-gallery-placeholder
                        hidden
                      >
                        <p class="font-display text-lg font-semibold tracking-tight text-ink">{shot.title}</p>
                        <p class="max-w-sm text-sm text-muted">{shot.description}</p>
                        <p class="mt-2 font-mono text-[11px] text-faint">{shot.src}</p>
                      </div>
                      <div
                        class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#07090e] via-[#07090e]/70 to-transparent"
                        aria-hidden="true"
                      >
                      </div>
                    </div>
                    <figcaption class="flex flex-col gap-2 border-t border-white/10 px-5 py-4 sm:flex-row sm:items-end sm:justify-between sm:gap-8 sm:px-6 sm:py-5">
                      <div class="min-w-0">
                        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-cyan">
                          {String(index + 1).padStart(2, "0")} · {shot.label}
                        </p>
                        <p class="mt-1.5 font-display text-lg font-semibold tracking-tight">{shot.title}</p>
                      </div>
                      <p class="max-w-md text-sm leading-relaxed text-muted sm:text-right">
                        {shot.description}
                      </p>
                    </figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-gallery]").forEach((root) => {
    if (!(root instanceof HTMLElement)) return;

    const tabs = [...root.querySelectorAll("[data-gallery-tab]")];
    const panels = [...root.querySelectorAll("[data-gallery-panel]")];
    const urlEl = root.querySelector("[data-gallery-url]");
    const countEl = root.querySelector("[data-gallery-count]");
    const ids = [...new Set(tabs.map((tab) => (tab instanceof HTMLElement ? tab.dataset.galleryId : null)).filter(Boolean))];

    const show = (id) => {
      const index = ids.indexOf(id);
      tabs.forEach((tab) => {
        if (!(tab instanceof HTMLButtonElement)) return;
        const active = tab.dataset.galleryId === id;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        const active = panel.dataset.galleryId === id;
        panel.classList.toggle("hidden", !active);
        panel.classList.toggle("block", active);
        panel.toggleAttribute("hidden", !active);
        panel.classList.remove("gallery-in");
        if (active) {
          void panel.offsetWidth;
          panel.classList.add("gallery-in");
        }
      });
      if (urlEl instanceof HTMLElement) urlEl.textContent = id;
      if (countEl instanceof HTMLElement && index >= 0) {
        countEl.textContent = `${String(index + 1).padStart(2, "0")} / ${String(ids.length).padStart(2, "0")}`;
      }
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        if (!(tab instanceof HTMLButtonElement)) return;
        const id = tab.dataset.galleryId;
        if (id) show(id);
      });
    });

    root.querySelectorAll("[role='tablist']").forEach((list) => {
      const listTabs = [...list.querySelectorAll("[data-gallery-tab]")];
      listTabs.forEach((tab, index) => {
        tab.addEventListener("keydown", (event) => {
          if (!(event instanceof KeyboardEvent)) return;
          if (event.key !== "ArrowRight" && event.key !== "ArrowLeft" && event.key !== "ArrowDown" && event.key !== "ArrowUp" && event.key !== "Home" && event.key !== "End") {
            return;
          }
          event.preventDefault();
          let next = index;
          if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % listTabs.length;
          if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + listTabs.length) % listTabs.length;
          if (event.key === "Home") next = 0;
          if (event.key === "End") next = listTabs.length - 1;
          const nextTab = listTabs[next];
          if (!(nextTab instanceof HTMLButtonElement)) return;
          const id = nextTab.dataset.galleryId;
          if (!id) return;
          show(id);
          nextTab.focus();
        });
      });
    });

    root.querySelectorAll("[data-gallery-image]").forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;
      const placeholder = img.parentElement?.querySelector("[data-gallery-placeholder]");
      const revealPlaceholder = () => {
        img.hidden = true;
        if (placeholder instanceof HTMLElement) placeholder.hidden = false;
      };
      if (img.complete) {
        if (img.naturalWidth === 0) revealPlaceholder();
      } else {
        img.addEventListener("error", revealPlaceholder, { once: true });
      }
    });
  });
</script>
