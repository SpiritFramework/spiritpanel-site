---
import { docsUrl, githubUrl, nav } from "../data/site";

const columns = [
  { label: "Panel", links: nav.map((item) => ({ href: item.href, label: item.label })) },
  {
    label: "Project",
    links: [
      { href: docsUrl, label: "Docs" },
      { href: githubUrl, label: "GitHub" },
    ],
  },
];
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 font-display text-sm font-semibold tracking-tight">
          <img src="/logo.png" alt="" width="32" height="32" class="size-8 rounded-[10px]" />
          Spirit Panel
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
          Self-hosted game server control panel.
        </p>
      </div>
      <nav class="grid grid-cols-2 gap-12 sm:gap-16" aria-label="Footer">
        {
          columns.map((column) => (
            <div>
              <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-faint">{column.label}</p>
              <ul class="mt-3 space-y-2">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <p class="mt-10 border-t border-line pt-6 text-sm leading-relaxed text-faint">
      Licensed under AGPL-3.0. If you modify Spirit Panel and run it as a network service, you offer the corresponding source to users of that service.
    </p>
  </div>
</footer>
