---
import Icon from "../Icon.astro";

interface Link {
  href: string;
  title: string;
}

interface Props {
  prev?: Link | null;
  next?: Link | null;
}

const { prev = null, next = null } = Astro.props;
---

{
  (prev || next) && (
    <nav aria-label="Previous and next pages" class="mt-12 grid gap-3 border-t border-white/10 pt-6 sm:grid-cols-2">
      {prev ? (
        <a href={prev.href} class="group rounded-xl border border-white/10 px-4 py-3 transition-colors hover:border-white/20 hover:bg-white/[0.03]">
          <span class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[0.16em] text-faint">
            <Icon name="arrow" class="size-3.5 rotate-180" />
            Previous
          </span>
          <span class="mt-1 block font-display text-sm font-semibold tracking-tight group-hover:text-cyan">{prev.title}</span>
        </a>
      ) : (
        <span class="hidden sm:block" />
      )}
      {next && (
        <a href={next.href} class="group rounded-xl border border-white/10 px-4 py-3 text-right transition-colors hover:border-white/20 hover:bg-white/[0.03]">
          <span class="flex items-center justify-end gap-1.5 text-[11px] font-medium uppercase tracking-[0.16em] text-faint">
            Next
            <Icon name="arrow" class="size-3.5" />
          </span>
          <span class="mt-1 block font-display text-sm font-semibold tracking-tight group-hover:text-cyan">{next.title}</span>
        </a>
      )}
    </nav>
  )
}
