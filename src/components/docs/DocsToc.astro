---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  place?: "inline" | "rail";
}

const { headings = [], place = "rail" } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 0 && place === "rail" && (
    <nav aria-label="On this page" class="px-4 py-6">
      <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-faint">On this page</p>
      <ul class="mt-3 space-y-1.5">
        {items.map((heading) => (
          <li class:list={[heading.depth === 3 && "pl-3"]}>
            <a href={`#${heading.slug}`} class="block text-[13px] leading-snug text-muted transition-colors hover:text-ink">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  items.length > 0 && place === "inline" && (
    <details class="mt-6 rounded-xl border border-white/10 bg-[#0c1018] xl:hidden">
      <summary class="cursor-pointer px-4 py-3 text-sm text-ink">On this page</summary>
      <ul class="space-y-1.5 border-t border-white/10 px-4 py-3">
        {items.map((heading) => (
          <li class:list={[heading.depth === 3 && "pl-3"]}>
            <a href={`#${heading.slug}`} class="block text-sm text-muted hover:text-ink">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}
