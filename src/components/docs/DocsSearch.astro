---
import Icon from "../Icon.astro";

export interface DocsSearchItem {
  title: string;
  description: string;
  href: string;
  section: string;
  external?: boolean;
}

interface Props {
  items: DocsSearchItem[];
}

const { items } = Astro.props;
---

<div data-docs-search hidden class="fixed inset-0 z-50 flex items-start justify-center bg-black/70 px-4 pt-[12vh] backdrop-blur-sm">
  <div
    role="dialog"
    aria-modal="true"
    aria-label="Search the docs"
    class="w-full max-w-xl overflow-hidden rounded-2xl border border-white/10 bg-[#0c1018] shadow-[0_32px_80px_-36px_rgba(0,0,0,0.9)]"
  >
    <label class="flex items-center gap-3 border-b border-white/10 px-4">
      <span class="text-faint" aria-hidden="true">
        <Icon name="docs" />
      </span>
      <input
        type="search"
        placeholder="Search guides"
        data-docs-search-input
        class="h-12 w-full bg-transparent text-sm text-ink outline-none placeholder:text-faint"
      />
      <kbd class="hidden rounded-md border border-white/10 px-1.5 py-0.5 font-mono text-[10px] text-faint sm:inline">esc</kbd>
    </label>
    <ul data-docs-search-results class="max-h-80 overflow-y-auto p-2"></ul>
  </div>
</div>

<script define:vars={{ items }}>
void (function () {
  const root = document.querySelector("[data-docs-search]");
  const input = document.querySelector("[data-docs-search-input]");
  const results = document.querySelector("[data-docs-search-results]");
  if (!(root instanceof HTMLElement) || !(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) {
    return;
  }

  let active = 0;

  function closeSearch() {
    root.hidden = true;
    document.body.style.overflow = "";
  }

  function openSearch() {
    root.hidden = false;
    document.body.style.overflow = "hidden";
    input.value = "";
    active = 0;
    render("");
    input.focus();
  }

  function render(query) {
    const q = query.trim().toLowerCase();
    const matches = items
      .filter((item) => {
        const haystack = `${item.title} ${item.description} ${item.section}`.toLowerCase();
        return !q || haystack.includes(q);
      })
      .slice(0, 12);
    if (active > matches.length - 1) active = 0;
    results.replaceChildren();
    if (matches.length === 0) {
      const empty = document.createElement("li");
      empty.className = "px-3 py-6 text-center text-sm text-faint";
      empty.textContent = "No matching pages.";
      results.append(empty);
      return;
    }
    matches.forEach((item, index) => {
      const li = document.createElement("li");
      const link = document.createElement("a");
      link.href = item.href;
      if (item.external) {
        link.target = "_blank";
        link.rel = "noreferrer";
      }
      link.className = `block rounded-xl px-3 py-2.5 ${index === active ? "bg-white/[0.06]" : "hover:bg-white/[0.04]"}`;
      const title = document.createElement("span");
      title.className = "block text-sm text-ink";
      title.textContent = item.title;
      const meta = document.createElement("span");
      meta.className = "mt-0.5 block text-xs text-faint";
      meta.textContent = item.external ? `${item.section} · opens FeatherPanel` : item.section;
      link.append(title, meta);
      link.addEventListener("click", () => closeSearch());
      li.append(link);
      results.append(li);
    });
  }

  document.querySelectorAll("[data-docs-search-open]").forEach((button) => {
    button.addEventListener("click", () => openSearch());
  });

  root.addEventListener("click", (event) => {
    if (event.target === root) closeSearch();
  });

  input.addEventListener("input", () => {
    active = 0;
    render(input.value);
  });

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (root.hidden) openSearch();
      else closeSearch();
      return;
    }
    if (root.hidden) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeSearch();
      return;
    }
    const links = [...results.querySelectorAll("a")];
    if (event.key === "ArrowDown") {
      event.preventDefault();
      active = Math.min(active + 1, links.length - 1);
      render(input.value);
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      active = Math.max(active - 1, 0);
      render(input.value);
    } else if (event.key === "Enter") {
      const link = links[active];
      if (link instanceof HTMLAnchorElement) {
        event.preventDefault();
        link.click();
      }
    }
  });
})();
</script>
