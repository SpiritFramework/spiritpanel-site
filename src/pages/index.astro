---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import InstallCommand from "../components/InstallCommand.astro";
import ProductGallery from "../components/ProductGallery.astro";
import { docsUrl, githubUrl } from "../data/site";

const pillars = [
  {
    eyebrow: "On the node",
    title: "Every server in its own container",
    points: [
      "FeatherWings starts the container",
      "CPU, RAM, disk, IO, and swap",
      "A limit of 0 means unlimited",
      "Reconnect on FeatherWings 1.4.3+",
    ],
  },
  {
    eyebrow: "For players",
    title: "The client area",
    points: [
      "Console with tab completion",
      "Files, editor, and startup",
      "Power, backups, and databases",
      "Schedules, subusers, SFTP, tickets",
    ],
  },
  {
    eyebrow: "At sign-in",
    title: "Sessions and keys",
    points: [
      "HttpOnly session cookies",
      "Optional 2FA",
      "Scoped application API keys",
      "Checks before a production boot",
    ],
  },
];
---

<Base
  title="Spirit Panel — Self-hosted game servers on FeatherWings"
  description="Spirit Panel is a self-hosted game server control panel. Users, nodes, and servers in one web UI. Game workloads run in Docker on FeatherWings."
>
  <section class="relative overflow-hidden">
    <div class="relative">
      <img
        src="/banner.png"
        alt="Spirit Panel — Manage, Host, Grow"
        width="1920"
        height="720"
        class="hero-shot h-[15rem] w-full object-cover object-center sm:h-[22rem] lg:h-[28rem]"
        fetchpriority="high"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(7,9,14,0.12)_0%,rgba(7,9,14,0.05)_40%,rgba(7,9,14,0.7)_78%,#07090e_100%)]"
        aria-hidden="true"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-5 pb-12 pt-8 lg:pb-16 lg:pt-10">
      <p class="inline-flex items-center gap-2 rounded-full border border-cyan/20 bg-[#0c1018]/80 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.18em] text-cyan">
        <span class="size-1.5 rounded-full bg-cyan shadow-[0_0_8px_#22d3ee]" aria-hidden="true"></span>
        Self-hosted · AGPL-3.0
      </p>
      <h1 class="mt-5 max-w-5xl font-display text-[2.45rem] font-semibold leading-[0.94] tracking-[-0.045em] sm:text-6xl lg:text-[4.75rem]">
        The game server panel you host <span class="text-cyan [text-shadow:0_0_28px_rgba(34,211,238,0.28)]">yourself.</span>
      </h1>
      <div class="mt-7 flex flex-col gap-5 sm:mt-8 lg:flex-row lg:items-end lg:justify-between">
        <p class="max-w-xl text-[15px] leading-relaxed text-muted sm:text-base">
          A web UI for users, nodes, and servers. Games stay in Docker on FeatherWings, on this machine or on their own nodes.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/get-started" class="btn btn-primary">
            Get started
            <Icon name="arrow" />
          </a>
          <a href="/features" class="btn btn-secondary">
            <Icon name="features" />
            See features
          </a>
        </div>
      </div>
      <dl class="mt-8 grid border-y border-white/10 sm:grid-cols-3 sm:divide-x sm:divide-white/10">
        <div class="flex gap-3 border-b border-white/10 py-4 sm:border-b-0 sm:pr-6">
          <span class="pt-0.5 font-display text-[11px] tabular-nums text-faint" aria-hidden="true">01</span>
          <div>
            <dt class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">FeatherWings</dt>
            <dd class="mt-1 text-sm text-muted">Docker for every server</dd>
          </div>
        </div>
        <div class="flex gap-3 border-b border-white/10 py-4 sm:border-b-0 sm:px-6">
          <span class="pt-0.5 font-display text-[11px] tabular-nums text-faint" aria-hidden="true">02</span>
          <div>
            <dt class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">One panel</dt>
            <dd class="mt-1 text-sm text-muted">Local daemon and remote nodes</dd>
          </div>
        </div>
        <div class="flex gap-3 py-4 sm:pl-6">
          <span class="pt-0.5 font-display text-[11px] tabular-nums text-faint" aria-hidden="true">03</span>
          <div>
            <dt class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">AGPL-3.0</dt>
            <dd class="mt-1 text-sm text-muted">You get the whole panel</dd>
          </div>
        </div>
      </dl>
    </div>
  </section>

  <ProductGallery />

  <section class="section-rise relative overflow-hidden border-y border-line bg-[#090c12]" aria-label="Nests and eggs">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_45%_at_50%_0%,rgba(34,211,238,0.1),transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-5 py-14 lg:py-20">
      <div class="max-w-2xl">
        <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Nests and eggs</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
          Pterodactyl eggs, grouped into nests.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted">
          Bring the egg JSON you already use. A nest is the category. The egg is the template FeatherWings uses to start the server.
        </p>
      </div>

      <ol class="mt-10 grid gap-4 lg:grid-cols-3 lg:gap-0">
        <li class="relative flex flex-col border-t border-white/10 pt-6 lg:border-t-0 lg:border-l lg:border-white/10 lg:pl-6 lg:first:border-l-0 lg:first:pl-0">
          <div class="flex items-center gap-3">
            <span class="font-display text-sm tabular-nums text-cyan">01</span>
            <span class="h-px flex-1 bg-white/10" aria-hidden="true"></span>
            <span class="text-[11px] font-medium uppercase tracking-[0.16em] text-muted">Nest</span>
          </div>
          <h3 class="mt-5 font-display text-xl font-semibold tracking-tight">A category you name</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Related eggs live together under a label you choose. Add as many eggs as you need.
          </p>
          <div class="mt-6 flex flex-1 flex-col justify-end gap-2">
            <div class="rounded-xl border border-white/10 bg-[#07090e] px-4 py-3">
              <p class="font-mono text-[11px] text-faint">example nests</p>
              <ul class="mt-2 space-y-1.5 text-sm text-ink">
                <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-cyan/70" aria-hidden="true"></span>Minecraft</li>
                <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-cyan/70" aria-hidden="true"></span>Source Engine</li>
                <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-cyan/70" aria-hidden="true"></span>FiveM</li>
              </ul>
            </div>
          </div>
        </li>

        <li class="relative flex flex-col border-t border-white/10 pt-6 lg:border-t-0 lg:border-l lg:border-white/10 lg:pl-6">
          <div class="flex items-center gap-3">
            <span class="font-display text-sm tabular-nums text-cyan">02</span>
            <span class="h-px flex-1 bg-white/10" aria-hidden="true"></span>
            <span class="text-[11px] font-medium uppercase tracking-[0.16em] text-muted">Egg</span>
          </div>
          <h3 class="mt-5 font-display text-xl font-semibold tracking-tight">The start template</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Import Pterodactyl egg JSON. A newer import refreshes the template and keeps servers already on it.
          </p>
          <div class="mt-6 overflow-hidden rounded-xl border border-cyan/25 bg-[#07090e]">
            <div class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-2.5">
              <p class="truncate font-mono text-[12px] text-ink">egg-export.json</p>
              <span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.14em] text-cyan">PTDL_v2</span>
            </div>
            <ul class="divide-y divide-white/10 font-mono text-[12px] text-muted">
              <li class="px-4 py-2.5 text-ink">docker_images</li>
              <li class="px-4 py-2.5 text-ink">startup</li>
              <li class="px-4 py-2.5 text-ink">variables</li>
              <li class="px-4 py-2.5 text-ink">installation</li>
            </ul>
          </div>
        </li>

        <li class="relative flex flex-col border-t border-white/10 pt-6 lg:border-t-0 lg:border-l lg:border-white/10 lg:pl-6">
          <div class="flex items-center gap-3">
            <span class="font-display text-sm tabular-nums text-cyan">03</span>
            <span class="h-px flex-1 bg-white/10" aria-hidden="true"></span>
            <span class="text-[11px] font-medium uppercase tracking-[0.16em] text-muted">Server</span>
          </div>
          <h3 class="mt-5 font-display text-xl font-semibold tracking-tight">Docker on FeatherWings</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            The panel never runs the game itself. FeatherWings starts each server in its own container.
          </p>
          <div class="mt-6 grid grid-cols-2 gap-2">
            {
              ["Console", "Files", "Backups", "Schedules"].map((item) => (
                <div class="rounded-xl border border-white/10 bg-[#07090e] px-3 py-3 text-sm text-ink">
                  {item}
                </div>
              ))
            }
          </div>
        </li>
      </ol>

      <p class="mt-8 max-w-3xl border-t border-white/10 pt-6 text-sm leading-relaxed text-muted">
        Minecraft plugins from Modrinth and the FiveM marketplace ship with the panel. Other games come from the eggs you import.
      </p>
    </div>
  </section>

  <section class="section-rise mx-auto max-w-6xl px-5 py-14 lg:py-20">
    <div class="max-w-2xl">
      <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Same box or remote</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        Built for the machine you already have.
      </h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-muted">
        The panel is the control plane. FeatherWings, with Docker, is what actually starts each game. One panel can use a daemon on the same host and nodes on other machines at the same time.
      </p>
    </div>
    <div class="mt-10 overflow-hidden rounded-[14px] border border-white/10 bg-[#07090e]">
      <div class="grid lg:grid-cols-3 lg:divide-x lg:divide-white/10">
        <article class="border-b border-white/10 p-5 sm:p-6 lg:border-b-0">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Spirit Panel</p>
          <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">Users, nodes, and servers</h3>
          <p class="mt-3 font-mono text-[13px] text-ink">Control plane</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">The web UI, sessions, and API live here. The game process does not.</p>
        </article>
        <article class="border-b border-white/10 p-5 sm:p-6 lg:border-b-0">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Same box</p>
          <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">Daemon on this host</h3>
          <p class="mt-3 font-mono text-[13px] text-ink">127.0.0.1:8080</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">nginx proxies the console websocket at <span class="font-mono text-[13px] text-ink">/wings/</span>.</p>
        </article>
        <article class="border-b border-white/10 p-5 sm:p-6 lg:border-b-0">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Remote node</p>
          <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">Daemon on another machine</h3>
          <p class="mt-3 font-mono text-[13px] text-ink">API_URL</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">HTTPS, no trailing slash. It must match the FeatherWings remote exactly.</p>
        </article>
      </div>
      <div class="grid border-t border-white/10 lg:grid-cols-3 lg:divide-x lg:divide-white/10">
        {
          pillars.map((item) => (
            <article class="border-b border-white/10 p-5 last:border-b-0 sm:p-6 lg:border-b-0">
              <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">{item.eyebrow}</p>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">{item.title}</h3>
              <ul class="mt-4 space-y-2 text-sm text-muted">
                {item.points.map((point) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-2 size-1 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>
                    {point}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="install" class="section-rise border-t border-line">
    <div class="mx-auto max-w-6xl px-5 py-14 lg:py-20">
      <div class="overflow-hidden rounded-[14px] border border-white/10 bg-[#07090e] lg:grid lg:grid-cols-2">
        <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Install</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
            Install it on your own server.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-muted">
            Ubuntu 22.04+ or Debian 12+. Ubuntu 24.04 LTS is the recommended production host.
          </p>
          <ol class="mt-8 divide-y divide-white/10 border-y border-white/10">
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4 py-4">
              <span class="font-display text-sm text-cyan">01</span>
              <p class="text-sm leading-relaxed text-muted"><span class="text-ink">Point DNS first.</span> The domain has to reach the server before the certificate is issued.</p>
            </li>
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4 py-4">
              <span class="font-display text-sm text-cyan">02</span>
              <p class="text-sm leading-relaxed text-muted"><span class="text-ink">The script provisions the stack.</span> Node 20, pnpm, MariaDB, Redis, nginx, and Let's Encrypt.</p>
            </li>
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4 py-4">
              <span class="font-display text-sm text-cyan">03</span>
              <p class="text-sm leading-relaxed text-muted"><span class="text-ink">Save the script, then run it.</span> Do not pipe curl into bash under sudo.</p>
            </li>
          </ol>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/get-started" class="btn btn-primary">
              <Icon name="terminal" />
              Install steps
            </a>
            <a href={docsUrl} class="btn btn-secondary">
              <Icon name="docs" />
              Read the docs
            </a>
          </div>
        </div>
        <div class="flex flex-col justify-center border-t border-white/10 bg-[#090c12] p-6 sm:p-8 lg:border-l lg:border-t-0 lg:p-10">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Two commands</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            The menu covers install, update, status, backup, and uninstall.
          </p>
          <div class="mt-6 overflow-hidden rounded-xl border border-white/10 bg-[#07090e]">
            <InstallCommand id="home-install" embedded />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-rise border-t border-line">
    <div class="mx-auto max-w-6xl px-5 py-14 lg:py-20">
      <div class="rounded-[14px] bg-[linear-gradient(180deg,rgba(255,255,255,0.18),rgba(34,211,238,0.32)_10%,rgba(99,102,241,0.22)_42%,rgba(255,255,255,0.05))] p-px shadow-[0_32px_80px_-46px_rgba(34,211,238,0.55)]">
        <div class="overflow-hidden rounded-[13px] bg-[#07090e]">
          <div class="relative px-6 pb-8 pt-7 sm:px-8 sm:pt-9 lg:px-10 lg:pb-10 lg:pt-11">
            <div
              class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(34,211,238,0.12),transparent_52%)]"
              aria-hidden="true"
            >
            </div>
            <div class="relative flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
              <div class="max-w-3xl">
                <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan">License · AGPL-3.0</p>
                <h2 class="mt-4 font-display text-4xl font-semibold leading-[0.96] tracking-[-0.045em] sm:text-5xl lg:text-6xl">
                  The panel you install is the <span class="text-cyan [text-shadow:0_0_28px_rgba(34,211,238,0.28)]">whole panel.</span>
                </h2>
              </div>
              <a
                href={githubUrl}
                class="inline-flex w-fit shrink-0 items-center gap-4 rounded-2xl border border-white/10 bg-[#0c1018] py-2.5 pl-4 pr-2.5 transition-colors hover:border-cyan/30 hover:bg-[#121722]"
              >
                <span class="font-mono text-[12px] text-ink">SpiritFramework/SpiritPanel</span>
                <span class="btn btn-primary btn-sm">
                  <Icon name="github" />
                  GitHub
                </span>
              </a>
            </div>
          </div>
          <div class="grid border-t border-white/10 sm:grid-cols-3 sm:divide-x sm:divide-white/10">
            <a href={githubUrl} class="group border-b border-white/10 px-6 py-6 transition-colors hover:bg-white/[0.03] sm:border-b-0 sm:px-8 lg:px-10">
              <p class="font-display text-[11px] tabular-nums text-faint">01</p>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">Source</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">The files on GitHub are the panel you install.</p>
            </a>
            <a href={`${githubUrl}/issues`} class="group border-b border-white/10 px-6 py-6 transition-colors hover:bg-white/[0.03] sm:border-b-0 sm:px-8 lg:px-10">
              <p class="font-display text-[11px] tabular-nums text-faint">02</p>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">Issues</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">Bugs and changes are tracked on the same repository.</p>
            </a>
            <a href={`${githubUrl}/releases`} class="group px-6 py-6 transition-colors hover:bg-white/[0.03] sm:px-8 lg:px-10">
              <p class="font-display text-[11px] tabular-nums text-faint">03</p>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">Releases</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">Published versions stay next to the source they came from.</p>
            </a>
          </div>
          <div class="flex gap-3 border-t border-white/10 bg-[#090c12] px-6 py-5 sm:px-8 lg:px-10">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-cyan shadow-[0_0_8px_#22d3ee]" aria-hidden="true"></span>
            <p class="text-sm leading-relaxed text-muted">
              <span class="text-ink">Network service.</span> If you change Spirit Panel and run that version as a network service, you offer the corresponding source to the people using it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
