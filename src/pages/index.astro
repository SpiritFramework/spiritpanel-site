---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import InstallCommand from "../components/InstallCommand.astro";
import ProductGallery from "../components/ProductGallery.astro";
import { docsUrl, githubUrl } from "../data/site";

const pillars = [
  {
    eyebrow: "On the node",
    title: "Every server in its own container",
    points: [
      "FeatherWings starts the container",
      "CPU, RAM, disk, IO, and swap",
      "A limit of 0 means unlimited",
      "Reconnect on FeatherWings 1.4.3+",
    ],
  },
  {
    eyebrow: "For players",
    title: "The client area",
    points: [
      "Console with tab completion",
      "Files, editor, and startup",
      "Power, backups, and databases",
      "Schedules, subusers, SFTP, tickets",
    ],
  },
  {
    eyebrow: "At sign-in",
    title: "Sessions and keys",
    points: [
      "HttpOnly session cookies",
      "Optional 2FA",
      "Scoped application API keys",
      "Checks before a production boot",
    ],
  },
];
---

<Base
  title="Spirit Panel — Self-hosted game servers on FeatherWings"
  description="Spirit Panel is a self-hosted game server control panel. Users, nodes, and servers in one web UI. Game workloads run in Docker on FeatherWings."
>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(148,163,184,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[size:4.5rem_4.5rem] [mask-image:radial-gradient(ellipse_75%_50%_at_50%_0%,black_10%,transparent_72%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 -top-28 h-[32rem] bg-[radial-gradient(ellipse_at_top,rgba(34,211,238,0.16),transparent_58%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto flex max-w-6xl flex-col px-5 pt-10 sm:pt-14">
      <div class="flex items-center gap-3 sm:gap-4">
        <img src="/logo.png" alt="" width="56" height="56" class="size-12 rounded-2xl sm:size-14" />
        <p class="font-display text-[2.6rem] font-semibold leading-none tracking-[-0.05em] sm:text-6xl lg:text-7xl">
          Spirit Panel
        </p>
      </div>
      <h1 class="mt-6 max-w-3xl font-display text-2xl font-medium leading-snug tracking-[-0.03em] text-ink sm:text-3xl">
        The game server panel you host yourself.
      </h1>
      <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-muted sm:text-base">
        A web UI for users, nodes, and servers. Games stay in Docker on FeatherWings, on this machine or on their own nodes.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/get-started" class="btn btn-primary">
          Get started
          <Icon name="arrow" />
        </a>
        <a href={docsUrl} class="btn btn-secondary">
          <Icon name="docs" />
          Read the docs
        </a>
      </div>
      <figure class="hero-shot relative mt-10 w-screen max-w-[100vw] [margin-left:calc(50%-50vw)]">
        <img
          src="/gallery/dashboard.png"
          alt="Spirit Panel client dashboard showing servers and status"
          width="1920"
          height="1080"
          fetchpriority="high"
          class="block h-auto w-full"
        />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#07090e] to-transparent" aria-hidden="true"></div>
      </figure>
    </div>
  </section>

  <ProductGallery />

  <section class="section-rise border-y border-line bg-[#090c12]" aria-label="Nests and eggs">
    <div class="mx-auto max-w-6xl px-5 py-14 lg:py-16">
      <div class="max-w-2xl">
        <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Nests and eggs</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
          Pterodactyl eggs, grouped into nests.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted">
          Bring the egg JSON you already use. A nest is the category. The egg is the template FeatherWings uses to start the server.
        </p>
      </div>
      <div class="mt-10 rounded-[14px] bg-[linear-gradient(180deg,rgba(255,255,255,0.14),rgba(34,211,238,0.22)_14%,rgba(255,255,255,0.04))] p-px">
        <div class="rounded-[13px] bg-[#07090e]">
          <div class="grid items-center gap-3 p-3 sm:p-4 lg:grid-cols-[minmax(0,0.9fr)_auto_minmax(0,1.15fr)_auto_minmax(0,0.9fr)] lg:gap-4 lg:p-5">
            <article class="rounded-xl border border-white/10 bg-[#0c1018] p-5">
              <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-faint">01 · Nest</p>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">A category you name</h3>
              <ul class="mt-4 space-y-2 text-sm text-muted">
                <li class="flex items-center gap-2"><span class="size-1 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>Related eggs, one place</li>
                <li class="flex items-center gap-2"><span class="size-1 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>A name you choose</li>
                <li class="flex items-center gap-2"><span class="size-1 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>As many eggs as you need</li>
              </ul>
            </article>
            <div class="flex items-center justify-center" aria-hidden="true">
              <span class="flex size-7 items-center justify-center rounded-full border border-cyan/30 bg-[#07090e] text-cyan">
                <svg viewBox="0 0 16 16" class="size-3.5 rotate-90 lg:rotate-0" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M3 8h10M9 4l4 4-4 4"></path>
                </svg>
              </span>
            </div>
            <article class="rounded-xl border border-cyan/30 bg-[#0c1018] p-5 shadow-[0_0_40px_-30px_rgba(34,211,238,0.85)]">
              <div class="flex items-center justify-between gap-3">
                <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">02 · Egg</p>
                <span class="rounded-full border border-cyan/30 bg-cyan/10 px-2 py-0.5 font-mono text-[10px] leading-none text-cyan">PTDL_v2</span>
              </div>
              <p class="mt-3 font-mono text-[13px] text-ink">egg-export.json</p>
              <ul class="mt-3 space-y-1.5 font-mono text-[12px] text-ink">
                <li class="flex items-center gap-2 rounded-md bg-white/[0.03] px-2.5 py-1.5"><span class="size-1 shrink-0 rounded-full bg-cyan" aria-hidden="true"></span>docker_images</li>
                <li class="flex items-center gap-2 rounded-md bg-white/[0.03] px-2.5 py-1.5"><span class="size-1 shrink-0 rounded-full bg-cyan" aria-hidden="true"></span>startup</li>
                <li class="flex items-center gap-2 rounded-md bg-white/[0.03] px-2.5 py-1.5"><span class="size-1 shrink-0 rounded-full bg-cyan" aria-hidden="true"></span>variables</li>
                <li class="flex items-center gap-2 rounded-md bg-white/[0.03] px-2.5 py-1.5"><span class="size-1 shrink-0 rounded-full bg-cyan" aria-hidden="true"></span>installation</li>
              </ul>
              <p class="mt-3 text-xs leading-relaxed text-muted">A newer import refreshes the template and keeps the servers already on it.</p>
            </article>
            <div class="flex items-center justify-center" aria-hidden="true">
              <span class="flex size-7 items-center justify-center rounded-full border border-cyan/30 bg-[#07090e] text-cyan">
                <svg viewBox="0 0 16 16" class="size-3.5 rotate-90 lg:rotate-0" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M3 8h10M9 4l4 4-4 4"></path>
                </svg>
              </span>
            </div>
            <article class="rounded-xl border border-white/10 bg-[#0c1018] p-5">
              <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-faint">03 · Server</p>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">Docker on FeatherWings</h3>
              <ul class="mt-4 space-y-2 text-sm text-muted">
                <li class="flex items-center gap-2"><span class="size-1 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>Console</li>
                <li class="flex items-center gap-2"><span class="size-1 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>Files</li>
                <li class="flex items-center gap-2"><span class="size-1 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>Backups</li>
                <li class="flex items-center gap-2"><span class="size-1 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>Schedules</li>
              </ul>
              <p class="mt-4 text-xs leading-relaxed text-faint">The panel never runs the game itself.</p>
            </article>
          </div>
          <p class="border-t border-white/10 px-5 py-3.5 text-sm text-muted">
            Minecraft plugins from Modrinth and the FiveM marketplace ship with the panel. Other games come from the eggs you import.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-rise mx-auto max-w-6xl px-5 py-14 lg:py-20">
    <div class="max-w-2xl">
      <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Same box or remote</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        Built for the machine you already have.
      </h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-muted">
        The panel is the control plane. FeatherWings, with Docker, is what actually starts each game. One panel can use a daemon on the same host and nodes on other machines at the same time.
      </p>
    </div>
    <div class="mt-10 border-y border-white/10">
      <div class="grid lg:grid-cols-3 lg:divide-x lg:divide-white/10">
        <article class="border-b border-white/10 p-5 sm:p-6 lg:border-b-0">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Spirit Panel</p>
          <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">Users, nodes, and servers</h3>
          <p class="mt-3 font-mono text-[13px] text-ink">Control plane</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">The web UI, sessions, and API live here. The game process does not.</p>
        </article>
        <article class="border-b border-white/10 p-5 sm:p-6 lg:border-b-0">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Same box</p>
          <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">Daemon on this host</h3>
          <p class="mt-3 font-mono text-[13px] text-ink">127.0.0.1:8080</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">nginx proxies the console websocket at <span class="font-mono text-[13px] text-ink">/wings/</span>.</p>
        </article>
        <article class="border-b border-white/10 p-5 sm:p-6 lg:border-b-0">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Remote node</p>
          <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">Daemon on another machine</h3>
          <p class="mt-3 font-mono text-[13px] text-ink">API_URL</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">HTTPS, no trailing slash. It must match the FeatherWings remote exactly.</p>
        </article>
      </div>
      <div class="grid border-t border-white/10 lg:grid-cols-3 lg:divide-x lg:divide-white/10">
        {
          pillars.map((item) => (
            <article class="border-b border-white/10 p-5 last:border-b-0 sm:p-6 lg:border-b-0">
              <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">{item.eyebrow}</p>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">{item.title}</h3>
              <ul class="mt-4 space-y-2 text-sm text-muted">
                {item.points.map((point) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-2 size-1 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>
                    {point}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="install" class="section-rise border-t border-line">
    <div class="mx-auto max-w-6xl px-5 py-14 lg:py-20">
      <div class="lg:grid lg:grid-cols-2 lg:items-center lg:gap-12">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Install</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
            Install it on your own server.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-muted">
            Ubuntu 22.04+ or Debian 12+. Ubuntu 24.04 LTS is the recommended production host.
          </p>
          <ol class="mt-8 divide-y divide-white/10 border-y border-white/10">
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4 py-4">
              <span class="font-display text-sm text-cyan">01</span>
              <p class="text-sm leading-relaxed text-muted"><span class="text-ink">Point DNS first.</span> The domain has to reach the server before the certificate is issued.</p>
            </li>
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4 py-4">
              <span class="font-display text-sm text-cyan">02</span>
              <p class="text-sm leading-relaxed text-muted"><span class="text-ink">The script provisions the stack.</span> Node 20, pnpm, MariaDB, Redis, nginx, and Let's Encrypt.</p>
            </li>
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4 py-4">
              <span class="font-display text-sm text-cyan">03</span>
              <p class="text-sm leading-relaxed text-muted"><span class="text-ink">Save the script, then run it.</span> Do not pipe curl into bash under sudo.</p>
            </li>
          </ol>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/get-started" class="btn btn-primary">
              <Icon name="terminal" />
              Install steps
            </a>
            <a href={docsUrl} class="btn btn-secondary">
              <Icon name="docs" />
              Read the docs
            </a>
          </div>
        </div>
        <div class="mt-10 flex flex-col justify-center lg:mt-0">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Two commands</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            The menu covers install, update, status, backup, and uninstall.
          </p>
          <div class="mt-6 overflow-hidden rounded-xl border border-white/10 bg-[#07090e]">
            <InstallCommand id="home-install" embedded />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-rise border-t border-line">
    <div class="mx-auto max-w-6xl px-5 py-14 lg:py-16">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan">License · AGPL-3.0</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
            The panel you install is the whole panel.
          </h2>
        </div>
        <a href={githubUrl} class="btn btn-secondary">
          <Icon name="github" />
          SpiritFramework/SpiritPanel
        </a>
      </div>
      <div class="mt-8 grid border-t border-white/10 sm:grid-cols-3 sm:divide-x sm:divide-white/10">
        <a href={githubUrl} class="group border-b border-white/10 py-6 pr-6 transition-colors hover:text-cyan sm:border-b-0">
          <p class="font-display text-[11px] tabular-nums text-faint">01</p>
          <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">Source</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">The files on GitHub are the panel you install.</p>
        </a>
        <a href={`${githubUrl}/issues`} class="group border-b border-white/10 py-6 sm:border-b-0 sm:px-6">
          <p class="font-display text-[11px] tabular-nums text-faint">02</p>
          <h3 class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">Issues</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Bugs and changes are tracked on the same repository.</p>
        </a>
        <a href={`${githubUrl}/releases`} class="group py-6 sm:pl-6">
          <p class="font-display text-[11px] tabular-nums text-faint">03</p>
          <h3 class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">Releases</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Published versions stay next to the source they came from.</p>
        </a>
      </div>
      <p class="mt-6 max-w-3xl border-t border-white/10 pt-6 text-sm leading-relaxed text-muted">
        <span class="text-ink">Network service.</span> If you change Spirit Panel and run that version as a network service, you offer the corresponding source to the people using it.
      </p>
    </div>
  </section>
</Base>
