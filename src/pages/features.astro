---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

const groups = [
  {
    id: "admin",
    title: "Admin",
    lede: "Fleet, people, templates, and the settings that brand the panel.",
    items: [
      {
        title: "Fleet management",
        body: "Locations, nodes, allocations, capacity meters, live health, diagnostics, and activity.",
      },
      {
        title: "Servers",
        body: "Provision from nests and eggs, then suspend, reinstall, set network and allocations, edit startup, and live-manage.",
      },
      {
        title: "Users",
        body: "Roles, suspensions, SSH keys, API keys, and per-user server access.",
      },
      {
        title: "Nests and eggs",
        body: "Group Pterodactyl egg JSON into nests, then edit variables, images, and install scripts.",
      },
      {
        title: "Domains",
        body: "Panel domain tooling for custom hostnames.",
      },
      {
        title: "Tickets",
        body: "Staff inbox with priorities and Discord webhook support.",
      },
      {
        title: "Announce",
        body: "Site-wide announcements for the client area.",
      },
      {
        title: "Activity",
        body: "Audit-style admin activity views.",
      },
      {
        title: "Settings and branding",
        body: "Branding Studio with a live preview, shell layout, atmosphere scenes, SMTP, and security settings.",
      },
      {
        title: "Plugins",
        body: "FiveM Marketplace, Minecraft plugins from Modrinth, and Database Manager.",
      },
      {
        title: "Resource limits",
        body: "CPU, RAM, disk, IO, and swap. Set a limit to 0 for unlimited.",
      },
    ],
  },
  {
    id: "client",
    title: "Client",
    lede: "What each server owner gets after a server is provisioned.",
    items: [
      {
        title: "Live console",
        body: "Tab completion from FeatherWings suggestions.",
      },
      {
        title: "Files",
        body: "File manager and a built-in editor.",
      },
      {
        title: "Startup",
        body: "Startup configuration and environment variables.",
      },
      {
        title: "Power",
        body: "Start, stop, restart, and kill.",
      },
      {
        title: "Backups and databases",
        body: "Backups, restore, databases, and schedules.",
      },
      {
        title: "Subusers",
        body: "Fine-grained permissions for people who share a server.",
      },
      {
        title: "SFTP",
        body: "SFTP access and server settings.",
      },
      {
        title: "Tickets",
        body: "Support tickets from the client area.",
      },
      {
        title: "Installable PWA",
        body: "Desktop, Android, and iOS, with a branding-aware manifest.",
      },
    ],
  },
  {
    id: "platform",
    title: "Platform",
    lede: "How the panel talks to FeatherWings, and how you automate it.",
    items: [
      {
        title: "FeatherWings API",
        body: "A Pterodactyl-compatible remote API for the Wings daemon.",
      },
      {
        title: "Application API",
        body: "Scoped keys for automation.",
      },
      {
        title: "Sessions",
        body: "HttpOnly session auth with optional 2FA.",
      },
      {
        title: "Production checks",
        body: "Environment validation and safety checks before a production boot.",
      },
      {
        title: "Reconnect",
        body: "Crash recovery and reconnect options for FeatherWings 1.4.3 and newer.",
      },
      {
        title: "Where it runs",
        body: "Same box or separate nodes. One panel can drive a local daemon and remote nodes together. The panel itself never runs the game.",
      },
    ],
  },
];
---

<Base
  title="Features — Spirit Panel"
  description="Admin fleet tools, the client console and files, and a FeatherWings-compatible API. What ships in Spirit Panel."
>
  <section class="relative overflow-hidden border-b border-line">
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(148,163,184,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[size:4.5rem_4.5rem] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,black_10%,transparent_68%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 -top-28 h-[28rem] bg-[radial-gradient(ellipse_at_top,rgba(34,211,238,0.14),transparent_60%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-5 pb-14 pt-12 lg:pb-16 lg:pt-16">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="" width="40" height="40" class="size-10 rounded-xl" />
        <p class="font-display text-4xl font-semibold leading-none tracking-[-0.05em] sm:text-6xl">Spirit Panel</p>
      </div>
      <h1 class="mt-6 max-w-3xl font-display text-2xl font-medium leading-snug tracking-[-0.03em] sm:text-3xl">
        Users, nodes, and servers. Games stay on FeatherWings.
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-muted">
        Spirit Panel is the control plane. FeatherWings is the daemon that runs each game server in Docker, on the panel host or on another machine.
      </p>
      <a href="/get-started" class="btn btn-primary mt-7">
        Install Spirit Panel
        <Icon name="arrow" />
      </a>
      <nav class="mt-12 grid border-t border-white/10 sm:grid-cols-3 sm:divide-x sm:divide-white/10" aria-label="Feature groups">
        {
          groups.map((group, index) => (
            <a
              href={`#${group.id}`}
              class="group border-b border-white/10 py-5 transition-colors last:border-b-0 hover:text-cyan sm:border-b-0 sm:px-6 sm:first:pl-0 sm:last:pr-0"
            >
              <p class="font-display text-[11px] tabular-nums text-faint">{String(index + 1).padStart(2, "0")}</p>
              <p class="mt-2 font-display text-lg font-semibold tracking-tight">{group.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{group.lede}</p>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    groups.map((group, groupIndex) => (
      <section
        id={group.id}
        class:list={[
          "scroll-mt-24 border-b border-line",
          groupIndex % 2 === 0 ? "bg-[#090c12]" : "bg-canvas",
        ]}
      >
        <div class="section-rise mx-auto max-w-6xl px-5 py-14 lg:py-16">
          <div class="flex flex-col gap-3 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
            <div class="max-w-2xl">
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan">
                {String(groupIndex + 1).padStart(2, "0")} · {group.title}
              </p>
              <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{group.title}</h2>
              <p class="mt-3 text-base leading-relaxed text-muted">{group.lede}</p>
            </div>
            <p class="font-mono text-[12px] text-faint">
              {String(group.items.length).padStart(2, "0")} capabilities
            </p>
          </div>
          <ul class="mt-2 divide-y divide-white/10">
            {group.items.map((item, itemIndex) => (
              <li class="grid gap-2 py-5 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8 sm:py-6">
                <span class="font-display text-[11px] tabular-nums text-faint" aria-hidden="true">
                  {String(itemIndex + 1).padStart(2, "0")}
                </span>
                <div class="min-w-0">
                  <h3 class="font-display text-lg font-semibold tracking-tight">{item.title}</h3>
                  <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted">{item.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-5 py-12">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-md text-sm leading-relaxed text-muted">
          Ready to run it on your own server.
        </p>
        <a href="/get-started" class="btn btn-primary">
          Install Spirit Panel
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
</Base>
