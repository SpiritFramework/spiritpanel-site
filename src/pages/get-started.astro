---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import InstallCommand from "../components/InstallCommand.astro";
import { docsUrl, githubUrl, wingsDocsUrl } from "../data/site";

const requirements = [
  {
    title: "Operating system",
    body: "Ubuntu 22.04 or newer, or Debian 12 or newer. Ubuntu 24.04 LTS is the recommended production host.",
  },
  {
    title: "What the installer adds",
    body: "Node 20, pnpm, MariaDB, Redis with a password, nginx, and a Let's Encrypt certificate. You do not install Node yourself.",
  },
  {
    title: "Game nodes",
    body: "FeatherWings, with Docker, on every machine that hosts games. That can be the panel host, other machines, or both.",
  },
];
---

<Base
  title="Get started — Spirit Panel"
  description="Install Spirit Panel on Ubuntu or Debian with the official script. The panel does not run games — FeatherWings does."
>
  <section class="relative overflow-hidden border-b border-line">
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(148,163,184,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[size:4.5rem_4.5rem] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,black_10%,transparent_68%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 -top-28 h-[28rem] bg-[radial-gradient(ellipse_at_top,rgba(99,102,241,0.26),transparent_60%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-5 pb-12 pt-14 lg:pb-16 lg:pt-20">
      <p class="inline-flex items-center gap-2 rounded-full border border-cyan/20 bg-[#0c1018]/80 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.18em] text-cyan">
        <span class="size-1.5 rounded-full bg-cyan shadow-[0_0_8px_#22d3ee]" aria-hidden="true"></span>
        Get started
      </p>
      <h1 class="mt-5 max-w-4xl font-display text-[2.45rem] font-semibold leading-[0.96] tracking-[-0.045em] sm:text-6xl lg:text-[4.25rem]">
        A Linux server, a domain, and the <span class="text-cyan [text-shadow:0_0_28px_rgba(34,211,238,0.28)]">installer.</span>
      </h1>
      <div class="mt-7 flex flex-col gap-5 sm:mt-8 lg:flex-row lg:items-end lg:justify-between">
        <p class="max-w-xl text-[15px] leading-relaxed text-muted sm:text-base">
          On a fresh Ubuntu or Debian server, download the installer and run it as root. The menu covers install, update, status, backup, and uninstall.
        </p>
        <a href="#install" class="btn btn-primary">
          Jump to install
          <Icon name="arrow" />
        </a>
      </div>
      <div class="mt-10 overflow-hidden rounded-[14px] border border-white/10 bg-[#07090e]">
        <div class="grid sm:grid-cols-3 sm:divide-x sm:divide-white/10">
          <a
            href="#requirements"
            class="group border-b border-white/10 px-5 py-5 transition-colors hover:bg-white/[0.03] sm:border-b-0 sm:px-6 lg:px-7"
          >
            <div class="flex items-center justify-between gap-3">
              <p class="font-display text-[11px] tabular-nums text-faint">01</p>
              <span class="text-cyan opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">↓</span>
            </div>
            <p class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">Linux server</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">Ubuntu 22.04+ or Debian 12+. Ubuntu 24.04 LTS recommended.</p>
          </a>
          <a
            href="#install"
            class="group border-b border-white/10 px-5 py-5 transition-colors hover:bg-white/[0.03] sm:border-b-0 sm:px-6 lg:px-7"
          >
            <div class="flex items-center justify-between gap-3">
              <p class="font-display text-[11px] tabular-nums text-faint">02</p>
              <span class="text-cyan opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">↓</span>
            </div>
            <p class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">Domain</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">Point DNS at the server before you install, so the certificate can issue.</p>
          </a>
          <a
            href="#install"
            class="group px-5 py-5 transition-colors hover:bg-white/[0.03] sm:px-6 lg:px-7"
          >
            <div class="flex items-center justify-between gap-3">
              <p class="font-display text-[11px] tabular-nums text-faint">03</p>
              <span class="text-cyan opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">↓</span>
            </div>
            <p class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">Installer</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">Two commands, then a menu for install, update, status, backup, and uninstall.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="requirements" class="scroll-mt-24 border-b border-line bg-[#090c12]">
    <div class="mx-auto max-w-6xl px-5 py-12 lg:py-14">
      <div class="overflow-hidden rounded-[14px] border border-white/10 bg-[#07090e]">
        <div class="border-b border-white/10 px-6 py-6 sm:px-8 lg:px-10">
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan">Before you install</p>
          <h2 class="mt-3 font-display text-2xl font-semibold tracking-tight sm:text-3xl">What you need on the box.</h2>
        </div>
        <div class="grid sm:grid-cols-3 sm:divide-x sm:divide-white/10">
          {
            requirements.map((item, index) => (
              <article class="border-b border-white/10 px-6 py-6 last:border-b-0 sm:border-b-0 sm:px-8 lg:px-10">
                <p class="font-display text-[11px] tabular-nums text-faint">{String(index + 1).padStart(2, "0")}</p>
                <h3 class="mt-3 font-display text-base font-semibold tracking-tight">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="install" class="scroll-mt-24 border-b border-line">
    <div class="mx-auto max-w-6xl px-5 py-14 lg:py-16">
      <div class="rounded-[14px] bg-[linear-gradient(180deg,rgba(255,255,255,0.14),rgba(34,211,238,0.22)_12%,rgba(255,255,255,0.04))] p-px">
        <div class="overflow-hidden rounded-[13px] bg-[#07090e]">
          <div class="border-b border-white/10 px-6 py-7 sm:px-8 lg:flex lg:items-end lg:justify-between lg:gap-10 lg:px-10 lg:py-8">
            <div class="max-w-2xl">
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan">Install · Three steps</p>
              <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">Run the installer on your server.</h2>
              <p class="mt-3 text-base leading-relaxed text-muted">
                DNS first, then the two commands, then FeatherWings where the games actually run.
              </p>
            </div>
            <p class="mt-5 font-mono text-[12px] text-faint lg:mt-0">spirit.sh</p>
          </div>

          <ol class="divide-y divide-white/10">
            <li class="grid gap-4 px-6 py-7 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-6 sm:px-8 lg:px-10">
              <span class="font-display text-sm text-cyan">01</span>
              <div class="min-w-0">
                <h3 class="font-display text-lg font-semibold tracking-tight">Point DNS first</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                  Point the panel domain at the server before you install, so certbot can issue a certificate.
                </p>
              </div>
            </li>

            <li class="grid min-w-0 gap-4 px-6 py-7 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-6 sm:px-8 lg:px-10">
              <span class="font-display text-sm text-cyan">02</span>
              <div class="min-w-0">
                <h3 class="font-display text-lg font-semibold tracking-tight">Download the script, then run it</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                  Save the installer to a file. Do not pipe curl into bash under sudo — process substitution breaks that way.
                </p>
                <div class="mt-5 overflow-hidden rounded-xl border border-white/10 bg-[#090c12]">
                  <InstallCommand id="setup-install" embedded />
                </div>
              </div>
            </li>

            <li class="grid min-w-0 gap-4 px-6 py-7 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-6 sm:px-8 lg:px-10">
              <span class="font-display text-sm text-cyan">03</span>
              <div class="min-w-0">
                <h3 class="font-display text-lg font-semibold tracking-tight">Add FeatherWings where the games run</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                  The panel never runs game workloads. Each server is a Docker container managed by FeatherWings. One panel can use a same-box daemon and remote nodes together.
                </p>
                <div class="mt-5 grid overflow-hidden rounded-xl border border-white/10 sm:grid-cols-2 sm:divide-x sm:divide-white/10">
                  <div class="border-b border-white/10 px-4 py-4 sm:border-b-0 sm:px-5">
                    <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Same box</p>
                    <p class="mt-2 font-mono text-[13px] text-ink">127.0.0.1:8080</p>
                    <p class="mt-2 text-sm leading-relaxed text-muted">
                      nginx proxies the console websocket at <span class="font-mono text-ink">/wings/</span>.
                    </p>
                  </div>
                  <div class="px-4 py-4 sm:px-5">
                    <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-cyan">Remote node</p>
                    <p class="mt-2 font-mono text-[13px] text-ink">HTTPS hostname</p>
                    <p class="mt-2 text-sm leading-relaxed text-muted">
                      Use HTTPS on that machine’s own hostname. No trailing slash on the remote URL.
                    </p>
                  </div>
                </div>
              </div>
            </li>
          </ol>

          <div class="flex gap-3 border-t border-white/10 bg-[#090c12] px-6 py-5 sm:px-8 lg:px-10">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-cyan shadow-[0_0_8px_#22d3ee]" aria-hidden="true"></span>
            <p class="text-sm leading-relaxed text-muted">
              <span class="font-mono text-ink">API_URL</span> in the panel environment must match the <span class="font-mono text-ink">remote</span> value in the FeatherWings config exactly: HTTPS, with no trailing slash.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="docs" class="scroll-mt-24 border-b border-line">
    <div class="mx-auto max-w-6xl px-5 py-14 lg:py-16">
      <div class="rounded-[14px] bg-[linear-gradient(180deg,rgba(255,255,255,0.18),rgba(34,211,238,0.32)_10%,rgba(99,102,241,0.22)_42%,rgba(255,255,255,0.05))] p-px shadow-[0_32px_80px_-46px_rgba(34,211,238,0.45)]">
        <div class="overflow-hidden rounded-[13px] bg-[#07090e]">
          <div class="relative border-b border-white/10 px-6 py-8 sm:px-8 lg:px-10 lg:py-10">
            <div
              class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(34,211,238,0.12),transparent_52%)]"
              aria-hidden="true"
            >
            </div>
            <div class="relative max-w-3xl">
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan">After install</p>
              <h2 class="mt-3 font-display text-3xl font-semibold leading-[0.98] tracking-[-0.04em] sm:text-4xl lg:text-5xl">
                Keep going in the <span class="text-cyan [text-shadow:0_0_28px_rgba(34,211,238,0.28)]">docs.</span>
              </h2>
              <p class="mt-4 text-base leading-relaxed text-muted">
                This page only gets you to the installer. Production detail, updates, and day-to-day operation live in the docs and on GitHub.
              </p>
            </div>
          </div>
          <div class="grid sm:grid-cols-3 sm:divide-x sm:divide-white/10">
            <a
              href={docsUrl}
              class="group border-b border-white/10 px-6 py-6 transition-colors hover:bg-white/[0.03] sm:border-b-0 sm:px-8 lg:px-10"
            >
              <div class="flex items-center justify-between gap-3">
                <p class="font-display text-[11px] tabular-nums text-faint">01</p>
                <span class="text-cyan opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">→</span>
              </div>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">Spirit Panel docs</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">Panel install follow-through, updates, and day-to-day operation.</p>
            </a>
            <a
              href={wingsDocsUrl}
              class="group border-b border-white/10 px-6 py-6 transition-colors hover:bg-white/[0.03] sm:border-b-0 sm:px-8 lg:px-10"
            >
              <div class="flex items-center justify-between gap-3">
                <p class="font-display text-[11px] tabular-nums text-faint">02</p>
                <span class="text-cyan opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">→</span>
              </div>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">FeatherWings docs</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">Daemon setup on the machines that actually host the games.</p>
            </a>
            <a
              href={githubUrl}
              class="group px-6 py-6 transition-colors hover:bg-white/[0.03] sm:px-8 lg:px-10"
            >
              <div class="flex items-center justify-between gap-3">
                <p class="font-display text-[11px] tabular-nums text-faint">03</p>
                <span class="text-cyan opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">→</span>
              </div>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight group-hover:text-cyan">GitHub</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">Source, issues, and releases for SpiritFramework/SpiritPanel.</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
